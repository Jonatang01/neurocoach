# NeuroCoach - Variables de Entorno
# Copia este archivo como .env.local y rellena tus claves

# OpenAI API Key (requerido para desarrollo local)
OPENAI_API_KEY=sk-your-api-key-here

# Vercel AI Gateway URL (opcional para desarrollo local, automático en Vercel)
# Reemplaza con la URL de tu gateway si quieres probarlo localmente
AI_GATEWAY_URL=https://gateway.ai.vercel.com/v1/projects/YOUR_PROJECT_ID/endpoints/YOUR_ENDPOINT_ID
